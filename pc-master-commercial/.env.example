# Скопируй в .env (он не попадает в git) и впиши свои значения.
# Ключ: elevenlabs.io → Profile → API Keys. Голос: npm run voice -- --list
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Модель с хорошим русским: eleven_multilingual_v2 (по умолчанию) или eleven_v3
ELEVENLABS_MODEL=eleven_multilingual_v2

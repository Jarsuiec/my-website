{
  "_doc": "Текст озвучки по речевым отрезкам (паузы в voice.mp3). [слово] — голубой акцент, {слово} — оранжевый, <слово> — зелёный. Время — секунды в voice.mp3.",
  "voice": "assets/voice.mp3",
  "chunks": [
    { "t": [0.149, 4.653],  "text": "Привет, меня зовут [Ярослав], я ремонтирую компьютеры и ноутбуки в [Варшаве] и [Прушкуве]." },
    { "t": [6.327, 7.823],  "text": "Знаете, что бесит больше всего?" },
    { "t": [8.513, 11.073], "text": "Когда ноутбук {ШУМИТ}, как {самолёт}," },
    { "t": [11.195, 13.422], "text": "и {тормозит} в самый неподходящий момент!" },
    { "t": [14.258, 16.057], "text": "А ведь чаще всего проблема простая:" },
    { "t": [16.357, 17.835], "text": "{пыль} и старая {термопаста}." },
    { "t": [18.303, 20.277], "text": "Час работы — и он снова <как новый!>" },
    { "t": [20.918, 22.250], "text": "Ещё один частый случай —" },
    { "t": [22.396, 23.539], "text": "старый жёсткий диск." },
    { "t": [23.980, 27.665], "text": "Поставил [SSD] — и система загружается [за секунды], а не за минуту!" },
    { "t": [28.667, 30.256], "text": "Я всегда говорю [цену заранее]." },
    { "t": [30.411, 31.390], "text": "<Никаких сюрпризов.>" },
    { "t": [32.001, 34.484], "text": "Объясню [по-русски], [по-украински] или [по-польски] —" },
    { "t": [34.673, 35.471], "text": "как вам удобнее." },
    { "t": [36.057, 37.290], "text": "Собрать [игровой компьютер?]" },
    { "t": [37.618, 38.292], "text": "<Легко!>" },
    { "t": [38.758, 40.152], "text": "Подобрать железо под [бюджет?]" },
    { "t": [40.415, 41.012], "text": "<Сделаю.>" },
    { "t": [41.390, 42.875], "text": "Настроить [Windows] [удалённо?]" },
    { "t": [43.283, 43.960], "text": "Тоже можно." },
    { "t": [44.488, 46.374], "text": "Так что если ваш компьютер капризничает —" },
    { "t": [46.526, 47.654], "text": "{не выбрасывайте} его." },
    { "t": [48.133, 50.348], "text": "Напишите мне в [Телеграм], разберёмся вместе." },
    { "t": [50.824, 52.583], "text": "Серьёзно, это проще, чем кажется." },
    { "t": [53.050, 54.272], "text": "Ну что, <договорились?>" }
  ]
}

# ===== WorkControl AI — настройки =====
# Скопируйте этот файл в .env и заполните значения.

# Пароль для входа в приложение. ОБЯЗАТЕЛЕН, если приложение доступно не только с этого компьютера.
APP_PASSWORD=

# Секрет для подписи сессий (любая длинная случайная строка). Если пусто — создаётся автоматически в data/secret.key
SESSION_SECRET=

# Папка с базой данных и резервными копиями
DATA_DIR=./data

# Адрес и порт. 127.0.0.1 = только этот компьютер. 0.0.0.0 = доступ из сети (требует APP_PASSWORD и HTTPS через прокси).
HOST=127.0.0.1
PORT=3000

# ---- AI (необязательно) ----
# Без ключа AI-помощник работает в локальном режиме (поиск и правила, без отправки данных наружу).
# ВНИМАНИЕ (GDPR): отправка рабочих писем во внешний AI возможна только с разрешения работодателя.
# Даже с ключом отправка включается отдельно в Настройках.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ---- Интеграции (этап 3, пока не реализованы) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
MIRAKL_API_URL=
MIRAKL_API_KEY=
ETSY_API_KEY=
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
APILO_API_URL=
APILO_CLIENT_ID=
APILO_CLIENT_SECRET=

# Часовой пояс (для «сегодня», «вчера», отложенных задач)
TZ=Europe/Warsaw
